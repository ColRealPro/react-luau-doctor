{
  "name": "@colrealpro/react-luau-doctor",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.20.1",
  "description": "Static analysis for React-Luau hooks, effects, rendering, and performance.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "react-luau-doctor": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:lsp": "cd editors/vscode && bunx --bun vsce package",
    "install:lsp": "bun run build:lsp && bun run scripts/install-lsp.ts",
    "benchmark:lsp": "bun run scripts/benchmark-lsp.ts",
    "check": "bunx tsc -p tsconfig.json --noEmit",
    "check:lsp": "npm --prefix editors/vscode run check",
    "test:lsp": "bun run scripts/build-lsp.ts && bun test tests/lsp.test.ts",
    "test": "bun run build && bun test --parallel=4",
    "doctor:example": "bun run src/cli.ts examples",
    "prepack": "bun run build && bun run check",
    "ci": "bun run build && bun run check && bun run check:lsp && bun run scripts/build-lsp.ts && bun test --parallel=4 && bun run scripts/verify-package.ts",
    "verify:package": "bun run build && bun run scripts/verify-package.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "web-tree-sitter": "0.26.11"
  },
  "devDependencies": {
    "@actions/workflow-parser": "0.3.61",
    "@types/bun": "1.4.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vscode-languageserver": "^10.1.2",
    "typescript": "5.8.3"
  },
  "keywords": [
    "roblox",
    "react-luau",
    "luau",
    "linter",
    "static-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colrealpro/react-luau-doctor.git"
  },
  "homepage": "https://github.com/colrealpro/react-luau-doctor#readme",
  "bugs": {
    "url": "https://github.com/colrealpro/react-luau-doctor/issues"
  }
}
